{
  "buildCommand": "npm run build:shared && npm run build:client",
  "outputDirectory": "apps/client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://zync-server-zt02.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://zync-server-zt02.onrender.com/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
