# PostgreSQL Connection String (e.g. Neon or Supabase free tier)
DATABASE_URL="postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/zync?sslmode=require"

# Redis Cache / Pub-Sub (e.g. Upstash free tier)
REDIS_URL="rediss://default:your-upstash-password@your-endpoint.upstash.io:6379"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="zync-access-super-secret-key-production-2026"
JWT_REFRESH_SECRET="zync-refresh-super-secret-key-production-2026"

# Brevo Transactional Email Provider (Free Tier)
BREVO_API_KEY="xkeysib-your-brevo-api-key"
BREVO_SENDER_EMAIL="notifications@yourdomain.com"
BREVO_SENDER_NAME="Zync Watch Party"

# Application URLs
CLIENT_URL="http://localhost:3000"
SERVER_URL="http://localhost:5000"
PORT=5000
